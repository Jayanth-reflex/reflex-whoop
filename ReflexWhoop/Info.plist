<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>ReflexWhoop</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- OAuth redirect URI target: reflexwhoop://oauth/callback -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.reflexwhoop.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>reflexwhoop</string>
			</array>
		</dict>
	</array>

	<!-- Exposes Documents/ in Files and over Finder-cable — the export path a free
	     Apple ID leaves us, since iCloud Drive integration needs an entitlement we
	     don't have. See docs/DECISIONS.md. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- Background App Refresh for the API sync engine (Phase 2), plus
	     bluetooth-central (Phase 4) so a connected band keeps delivering
	     notifications while the app is backgrounded — an overnight session
	     can still get suspended by iOS, but this is what makes it possible
	     at all on a free Apple ID (no entitlement required, unlike Push). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>bluetooth-central</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.reflexwhoop.sync.refresh</string>
	</array>

	<!-- CoreBluetooth (Phase 4) — direct connection to your own WHOOP band over
	     its custom fd4b… service. Read-only: no write path to any band setting
	     exists in this app. See docs/DECISIONS.md and the BLE safety rails in
	     docs/design.md. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>ReflexWhoop connects directly to your own WHOOP band to stream live heart rate and motion data alongside the WHOOP cloud data it already syncs.</string>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<!-- No cryptography beyond HTTPS/TLS and on-device Keychain/CryptoKit hashing —
	     no export-compliance encryption declaration needed. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
